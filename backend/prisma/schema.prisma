
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  googleId  String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          Sender[]
  campaigns        Campaign[]
  slackConnections SlackConnection[]
}

model Sender {
  id         String   @id @default(uuid())
  userId     String
  email      String
  displayName String?
  smtpHost   String
  smtpPort   Int
  smtpUser   String
  smtpPassword String
  hourlyLimit Int
  minDelayMs  Int     @default(2000)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id        String   @id @default(uuid())
  userId    String
  senderId  String
  subject   String
  body      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id])
  emails Email[]

  @@index([userId, createdAt])
}

model Email {
  id          String      @id @default(uuid())
  campaignId  String
  senderId    String
  recipient   String
  subject     String
  body        String
  scheduledAt        DateTime
  sentAt             DateTime?
  processingStartedAt DateTime?
  status             EmailStatus @default(SCHEDULED)
  jobId       String      @unique
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id])

  @@index([status, scheduledAt])
  @@index([senderId, status])
  @@index([recipient])
}

model SlackConnection {
  id           String   @id @default(uuid())
  userId       String
  teamId       String
  teamName     String?
  accessToken  String
  connected    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}
